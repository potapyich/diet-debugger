# Project environment — committed, no real values here.
# Real values go in .envrc.local (gitignored).
# Fallback: ~/.secrets (for Claude Code launched outside terminal)

# Load local overrides first
source_env_if_exists .envrc.local

# Fallback to ~/.secrets if vars are still unset
if [ -f "$HOME/.secrets" ]; then
  source_env_if_exists "$HOME/.secrets"
fi

# Validate required vars are set
if [ -z "$POSTGRES_CONNECTION_STRING" ]; then
  echo "direnv: POSTGRES_CONNECTION_STRING not set (define in .envrc.local or ~/.secrets)"
fi

if [ -z "$GITHUB_PERSONAL_ACCESS_TOKEN" ]; then
  echo "direnv: GITHUB_PERSONAL_ACCESS_TOKEN not set (define in .envrc.local or ~/.secrets)"
fi
